# Product display name. Used in API titles and the web shell.
PLATFORM_NAME=AI Agent Factory

# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
WEB_ORIGIN=http://localhost:3100
API_PUBLIC_URL=http://localhost:8080

# Database (platform control plane only)
DATABASE_URL=postgresql+psycopg://factory:factory@localhost:5433/factory

# Compose-only: credentials for the bundled Postgres container.
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory
POSTGRES_DB=factory

# Web server-side proxy target (FastAPI origin).
# Local `npm run dev` reads apps/web/.env.local instead of this file.
# The Compose build passes http://api:8080 to the web image.
API_ORIGIN=http://localhost:8080
# Public product name embedded in the browser bundle. Not a secret.
NEXT_PUBLIC_PLATFORM_NAME=AI Agent Factory

# Auth. Replace in any shared or production environment.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_TTL_MINUTES=720

# Provider-secret encryption (Fernet). Never commit a real key.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_SECRETS_KEY=replace-with-fernet-key

# Cookies are httpOnly; enable Secure once you serve the web app over HTTPS.
COOKIE_SECURE=false

# Optional: seed a first user/org/workspace on an empty database.
# Development and container bootstrap only; never overwrite an existing user.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: keep the ticketing dispatcher workflow across restarts. It is only
# created when the target organization already has an OpenAI-compatible model
# connection. The agent is not overwritten once it exists.
# BOOTSTRAP_TICKETING_BASE_URL=http://host.docker.internal:3000
# BOOTSTRAP_TICKETING_AGENT_KEY=<same value as AGENT_CONTEXT_SECRET in the ticketing app>
# BOOTSTRAP_TICKETING_MODEL=
# BOOTSTRAP_TICKETING_ORG_SLUG=

# Execution limits
GATEWAY_MAX_BODY_BYTES=262144
GATEWAY_TIMEOUT_SECONDS=60
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_MAX_MESSAGE_CHARS=8000
GATEWAY_MAX_EXTENSION_BYTES=32000
HTTP_NODE_MAX_RESPONSE_BYTES=2000000

# Authentication throttles (per process; use a shared store before scaling out)
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5
# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# Model endpoints, tools, and graph HTTP nodes may target localhost/private
# networks only when explicitly allowed. In production the default is false.
# Set true to use local Ollama or internal MCP servers from a production API.
# ALLOW_PRIVATE_PROVIDER_URLS=true

# In-app OIDC SSO. Leave SSO_ISSUER empty to disable the button; password login
# always remains available. Register this redirect URI in the identity provider:
#   http://localhost:3100/backend-api/api/v1/auth/sso/callback
# The callback stays on the web origin so the session cookie is first-party.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_BUTTON_LABEL=Continue with SSO
SSO_SCOPES=openid email profile
# SSO_REDIRECT_URI=
# Comma-separated allowed email domains. Empty allows any domain.
SSO_ALLOWED_DOMAINS=
SSO_ROLE_CLAIM=role
SSO_DEFAULT_ROLE=member
SSO_AUTO_CREATE_ORG=true
# SSO_DEFAULT_ORG_SLUG=default-org

