# Web app local environment. Copy to .env.local (gitignored).
# The browser calls /backend-api on this Next.js origin; the server proxies it
# to the FastAPI origin below.
API_ORIGIN=http://localhost:8080

# Public product name. This is not a secret and is embedded in the browser
# bundle. Keep it in sync with PLATFORM_NAME in the root .env if you brand the
# product.
NEXT_PUBLIC_PLATFORM_NAME=AI Agent Factory
